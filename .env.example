# Copy to apps/web/.env.local (web) and packages/contracts/.env (forge). NEVER commit real values.

# ── Chain (verified from docs.arc.io 2026-11-18) ──────────────────────────────
ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# Official Arc testnet USDC ERC-20 (6 decimals; same balance as native gas).
# Leave EMPTY to have Deploy.s.sol deploy a clearly-labeled MockUSDC instead.
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Web (lane D) ──────────────────────────────────────────────────────────────
# https://dashboard.privy.io → create app → App ID. Add Arc testnet (5042002) as a custom chain.
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Backend (lane C) ──────────────────────────────────────────────────────────
# Random 32+ byte secret for HMAC-signed order tokens: `openssl rand -hex 32`
ORDER_SIGNING_SECRET=

# ── Contracts / scripts (lane D) — packages/contracts/.env only ───────────────
# Generate with `cast wallet new`. NEVER use anvil/hardhat default keys on Arc (one is blocklisted).
DEPLOYER_PRIVATE_KEY=
MERCHANT_1_ISSUER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
BUYER_PRIVATE_KEY=

# ── Gift card swap (server only — NEVER prefix with NEXT_PUBLIC_) ──
# Server signs mintCredit as the fictional store's issuer + tops up new sellers' gas. Same key as packages/contracts/.env.
MERCHANT_1_ISSUER_PRIVATE_KEY=
# Encrypts vaulted card PINs at rest (>= 32 chars). Falls back to ORDER_SIGNING_SECRET if unset.
CARD_VAULT_KEY=
# Simulated retailer card store. Vercel: Storage -> Upstash Redis. Local dev without these uses apps/web/.data/kv.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
